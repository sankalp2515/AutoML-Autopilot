        "excerpt": "Edited refunds/analyze_scores.py",
        "at": 1793373436.1333838
      },
      "diff": "--- /dev/null\n+++ b/refunds/analyze_scores.py\n@@ -0,0 +1,44 @@\n+import pandas as pd\n+import joblib\n+from refunds.model import fit, scores\n+from refunds.features import matrix\n+\n+frame = pd.read_csv(\"data/train.csv\")\n+model = fit(frame)\n+scores_vals = scores(frame, model)\n+\n+print(\"Score stats:\")\n+print(f\"  Min: {scores_vals.min():.4f}\")\n+print(f\"  Max: {scores_vals.max():.4f}\")\n+print(f\"  Mean: {scores_vals.mean():.4f}\")\n+print(f\"  Median: {pd.Series(scores_vals).median():.4f}\")\n+\n+# Scores for positive cases\n+pos_scores = scores_vals[frame.outcome == 1]\n+neg_scores = scores_vals[frame.outcome == 0]\n+print(f\"\\nPositive cases: {len(pos_scores)}\")\n+print(f\"  Min: {pos_scores.min():.4f}\")\n+print(f\"  Max: {pos_scores.max():.4f}\")\n+print(f\"  Mean: {pos_scores.mean():.4f}\")\n+print(f\"  Median: {pd.Series(pos_scores).median():.4f}\")\n+print(f\"  >= 0.95: {(pos_scores >= 0.95).sum()} ({(pos_scores >= 0.95).mean()*100:.1f}%)\")\n+print(f\"  >= 0.90: {(pos_scores >= 0.90).sum()} ({(pos_scores >= 0.90).mean()*100:.1f}%)\")\n+print(f\"  >= 0.80: {(pos_scores >= 0.80).sum()} ({(pos_scores >= 0.80).mean()*100:.1f}%)\")\n+print(f\"  >= 0.70: {(pos_scores >= 0.70).sum()} ({(pos_scores >= 0.70).mean()*100:.1f}%)\")\n+print(f\"  >= 0.50: {(pos_scores >= 0.50).sum()} ({(pos_scores >= 0.50).mean()*100:.1f}%)\")\n+\n+print(f\"\\nNegative cases: {len(neg_scores)}\")\n+print(f\"  Min: {neg_scores.min():.4f}\")\n+print(f\"  Max: {neg_scores.max():.4f}\")\n+print(f\"  Mean: {neg_scores.mean():.4f}\")\n+print(f\"  Median: {pd.Series(neg_scores).median():.4f}\")\n+print(f\"  >= 0.95: {(neg_scores >= 0.95).sum()} ({(neg_scores >= 0.95).mean()*100:.1f}%)\")\n+print(f\"  >= 0.90: {(neg_scores >= 0.90).sum()} ({(neg_scores >= 0.90).mean()*100:.1f}%)\")\n+print(f\"  >= 0.80: {(neg_scores >= 0.80).sum()} ({(neg_scores >= 0.95).mean()*100:.1f}%)\")\n+print(f\"  >= 0.50: {(neg_scores >= 0.50).sum()} ({(neg_scores >= 0.50).mean()*100:.1f}%)\")\n+\n+# Check what threshold gives recall >= 0.7\n+for thresh in [0.95, 0.90, 0.80, 0.70, 0.60, 0.50, 0.40, 0.30, 0.20, 0.10]:\n+    recall = (pos_scores >= thresh).mean()\n+    precision = (pos_scores >= thresh).sum() / max(1, (scores_vals >= thresh).sum())\n+    print(f\"Threshold {thresh:.2f}: recall={recall:.3f}, precision={precision:.3f}\")\n",
