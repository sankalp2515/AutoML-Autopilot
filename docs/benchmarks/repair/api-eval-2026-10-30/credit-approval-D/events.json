      "diff": "--- /dev/null\n+++ b/credit/analyze_scores.py\n@@ -0,0 +1,42 @@\n+import pandas as pd\n+import joblib\n+from credit.model import fit, scores\n+from credit.policy import decisions\n+from sklearn.metrics import f1_score, recall_score, precision_score\n+\n+frame = pd.read_csv(\"data/train.csv\")\n+model = fit(frame)\n+scores_arr = scores(frame, model)\n+\n+print(\"Score stats:\")\n+print(f\"  min: {scores_arr.min():.4f}\")\n+print(f\"  max: {scores_arr.max():.4f}\")\n+print(f\"  mean: {scores_arr.mean():.4f}\")\n+print(f\"  median: {pd.Series(scores_arr).median():.4f}\")\n+\n+print(\"\\nScore distribution by outcome:\")\n+for outcome in [0, 1]:\n+    subset = scores_arr[frame.outcome == outcome]\n+    print(f\"  outcome={outcome}: min={subset.min():.4f}, max={subset.max():.4f}, mean={subset.mean():.4f}, median={pd.Series(subset).median():.4f}\")\n+\n+print(\"\\nThreshold analysis:\")\n+for thresh in [0.5, 0.6, 0.7, 0.8, 0.9, 0.95, 0.99]:\n+    preds = (scores_arr >= thresh).astype(int)\n+    f1 = f1_score(frame.outcome, preds)\n+    rec = recall_score(frame.outcome, preds)\n+    prec = precision_score(frame.outcome, preds)\n+    print(f\"  thresh={thresh}: F1={f1:.4f}, recall={rec:.4f}, precision={prec:.4f}\")\n+\n+print(\"\\nPer-region recall at threshold 0.5:\")\n+for region in frame.region.unique():\n+    mask = frame.region == region\n+    preds = (scores_arr[mask] >= 0.5).astype(int)\n+    rec = recall_score(frame.outcome[mask], preds)\n+    print(f\"  {region}: recall={rec:.4f}\")\n+\n+print(\"\\nPer-region recall at threshold 0.99:\")\n+for region in frame.region.unique():\n+    mask = frame.region == region\n+    preds = (scores_arr[mask] >= 0.99).astype(int)\n+    rec = recall_score(frame.outcome[mask], preds)\n+    print(f\"  {region}: recall={rec:.4f}\")\n",
