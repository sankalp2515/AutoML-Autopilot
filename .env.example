# AutoML Autopilot: copy to .env, fill in, then `docker compose up -d --build`.
# .env is git-ignored. Provider keys are passed to the worker container only.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Postgres password (internal network only). Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
# Shared secret between worker and verifier. Generate: openssl rand -hex 32
AUTOPILOT_VERIFIER_TOKEN=

# ── NVIDIA Nemotron (one of the two; Nebius wins when both are set) ───────────
# Nebius Token Factory (the judged path): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CODER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Sandbox-enabled Token Factory project; required only by the Nebius runner.
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes/v1
# NVIDIA API catalog (build.nvidia.com), same model family
NVIDIA_API_KEY=
NVIDIA_PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ENABLE_THINKING=false

# ── Tavily (runtime research for library-change incidents) ────────────────────
TAVILY_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
SECRET_KEY=change-this-in-production
AUTOPILOT_WORKER_CONCURRENCY=2
# Public-demo guards
AUTOPILOT_CREATES_PER_10MIN=6
AUTOPILOT_DAILY_LLM_CALLS=400
AUTOPILOT_DAILY_TAVILY_CALLS=200
AUTOPILOT_IDLE_EXPIRY_MIN=15
# Docker network subnets (change only if they collide with your networks)
# BACKPLANE_SUBNET=10.88.10.0/24
# EGRESS_SUBNET=10.88.11.0/24
# EDGE_SUBNET=10.88.12.0/24

# ── v5 repair services ────────────────────────────────────────────────────────
REPAIR_SANDBOX_TOKEN=change-me-sandbox-token
REPAIR_VERIFIER_TOKEN=change-me-verifier-token
REPAIR_ADMISSION_TOKEN=                         # REQUIRED: random >=32 chars, API and verifier only
REPAIR_TRUSTED_SANDBOX_TOKEN=                   # REQUIRED: distinct random >=32 chars, verifier and sandbox only
REPAIR_LEDGER_PASSWORD=                        # REQUIRED: distinct password for verifier-only PostgreSQL
POSTGRES_ADMIN_PASSWORD=                       # REQUIRED: database container only; app role is not a superuser
REPAIR_LEDGER_ADMIN_PASSWORD=                  # REQUIRED: ledger database container only
# BE-23 accounts (GitHub sign-in). Empty secret = anonymous demo only.
REPAIR_SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=
# BE-24 GitHub App. Webhook secret goes to the api; app id + private key only to repair-worker.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
REPAIR_ENV_HOST_DIR=/tmp/autopilot-envs   # same absolute path on the Docker host and in sandbox-runner
REPAIR_LIVE_ENABLED=false                 # live repairs spend model credits; replays always work
REPAIR_INVITE_CODES=
REPAIR_DAILY_USD_CAP=5
REPAIR_DAILY_TOKEN_CAP=2000000
# Judge-only deployment preset is available as scripts/v5_stack.py --judge-only.
# These controls limit estimated admission, not a provider invoice.
REPAIR_JUDGE_ONLY=false
REPAIR_TOTAL_USD_CAP=0
REPAIR_CREATE_COOLDOWN_S=0
REPAIR_MAX_ACTIVE_TASKS=0
REPAIR_DAILY_TASKS_PER_TENANT=5
REPAIR_TASK_USD_CEILING=0.40
REPAIR_PIP_INDEX_URL=https://pypi.org/simple
WEB_BIND=127.0.0.1                              # local by default; hosting owner configures the public TLS edge
