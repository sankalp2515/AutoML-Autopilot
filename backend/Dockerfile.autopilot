# AutoML Autopilot backend image: one image, three services (api, worker, verifier),
# each started with its own command in docker-compose.yml.
#
#   docker build -f backend/Dockerfile.autopilot -t automl-autopilot-backend backend
#
# Multi-stage: dependencies are built into a venv, the runtime stage has no compiler,
# runs as a non-root user and uses tini as PID 1 (signals reach Python; zombies of the
# experiment child processes are reaped).

FROM python:3.12-slim AS deps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements-runtime.txt /tmp/requirements-runtime.txt
RUN pip install -r /tmp/requirements-runtime.txt

FROM python:3.12-slim AS runtime
LABEL org.opencontainers.image.title="automl-autopilot-backend" \
      org.opencontainers.image.source="https://github.com/sankalp2515/AutoML-Autopilot" \
      org.opencontainers.image.licenses="GPL-3.0"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    DATA_DIR=/data
# libgomp1: OpenMP runtime for scikit-learn's histogram gradient boosting.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
 && mkdir -p /data && chown app:app /data
COPY --from=deps /opt/venv /opt/venv
WORKDIR /app
COPY app ./app
USER app
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
